        Divider,
        Header,
        Input,
        Selector,
        Switch,
        Text,
    )
    _UI_OK = True
except Exception:  # pragma: no cover
    Divider = Header = Input = Selector = Switch = Text = None
    _UI_OK = False

# 下面三个模块只用于「菜单弹窗 / 提示」，同样做降级处理
try:
    from client_utils import get_last_fragment  # pyright: ignore[reportMissingImports]
except Exception:  # pragma: no cover
    get_last_fragment = None

try:
    from ui.alert import AlertDialogBuilder  # pyright: ignore[reportMissingImports]
except Exception:  # pragma: no cover
    AlertDialogBuilder = None

try:
    from ui.bulletin import BulletinHelper  # pyright: ignore[reportMissingImports]
except Exception:  # pragma: no cover
