# Normalize line endings to LF in the repo, regardless of OS checkout.
* text=auto eol=lf

# Force LF for code/markdown
*.md       text eol=lf
*.py       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
LICENSE    text eol=lf

# Binary
*.png      binary
*.jpg      binary
*.svg      binary
